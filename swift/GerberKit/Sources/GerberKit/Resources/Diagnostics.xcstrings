    "%@: Excellon syntax conflicts with filename role %@." : {
      "comment" : "Warning: the file's name suggests one layer type but its contents are drill data. %1$@ is the file name, %2$@ is the layer name the file name suggested (for example 'Top copper'). 'Excellon' is the drill file format; keep it as written.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Excellon syntax conflicts with filename role %2$@."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Excellon-sintaksis bots met lêernaamrol %2$@."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : Excellon አገባብ ከፋይል ስም ሚና %2$@ ጋር ይጋጫል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : تعارضات في بناء جملة Excellon مع دور اسم الملف %2$@ ."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Excellon sintaksisi %2$@ fayl adı rolu ilə ziddiyyət təşkil edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Excellon сінтаксіс канфліктуе з роляй імя файла %2$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Синтаксисът на Excellon влиза в конфликт с ролята на имена на файлове %2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: Excellon সিনট্যাক্স %2$@ ফাইলনেম রোলের সাথে সাংঘর্ষিক।"
          }
        },
        "ca" : {
          "stringUnit" : {
