    "%@: inferred a routed endpoint join within %@ mm; verify the source gap." : {
      "comment" : "Warning: two outline lines did not quite meet, so the app assumed they connect. %1$@ is the file name, %2$@ is the gap distance as a number; 'mm' is millimeters.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: inferred a routed endpoint join within %2$@ mm; verify the source gap."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: het 'n gerouteerde eindpuntverbinding binne %2$@ mm afgelei; verifieer die brongaping."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : በ %2$@ ሚሜ ውስጥ የተዘዋወረ የመጨረሻ ነጥብ መቀላቀልን ገምቷል፤ የምንጭ ክፍተቱን ያረጋግጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : تم استنتاج ربط نقطة نهاية موجهة ضمن %2$@ مم؛ تحقق من فجوة المصدر."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ mm daxilində marşrutlaşdırılmış son nöqtə birləşməsini çıxarın; mənbə boşluğunu yoxlayın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: выведзена маршрутызаванае злучэнне канцавых кропак у межах %2$@ мм; праверыць зыходны прамежак."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: изведе се съединение на маршрутизирана крайна точка в рамките на %2$@ мм; проверете пропуските в изходните данни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : %2$@ mm-এর মধ্যে একটি রাউটেড এন্ডপয়েন্ট জয়েন অনুমান করা হয়েছে; সোর্স গ্যাপ যাচাই করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: s'ha inferit una unió de punt final encaminat dins %2$@ mm; verifica el buit d'origen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: bylo odvozeno spojení koncového bodu trasování v rámci %2$@ mm; ověřte mezeru ve zdroji."
          }
        },
        "cy" : {
