        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "አራት ማዕዘን/ዙሪያው አወንታዊ ስፋትና ቁመት እንዲሁም አማራጭ ክብ ቀዳዳ ይፈልጋል፤ የቆዩ አራት ማዕዘን ቅርጽ ያላቸው ቀዳዳዎች አይደገፉም።"
