        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ပိုလီဂွန်သည် အပေါင်းအချင်း၊ ၃...၁၂ ကိန်းပြည့်ထိပ်များ၊ အကန့်အသတ်ရှိသောလည်ပတ်မှုနှင့် ရွေးချယ်နိုင်သော အဝိုင်းအပေါက် လိုအပ်ပြီး ရိုးရာစတုဂံအပေါက်များကို ပံ့ပိုးမထားပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polygon krever en positiv diameter, 3–12 heltallige hjørner, en endelig rotasjon og et valgfritt rundt hull; eldre rektangulære hull støttes ikke."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुभुजलाई धनात्मक व्यास, ३...१२ पूर्णांक शिरोबिंदू, परिमित परिक्रमा र वैकल्पिक गोलाकार प्वाल चाहिन्छ; लिगेसी आयताकार प्वालहरू असमर्थित छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een polygoon moet een positieve diameter hebben, 3 tot 12 gehele hoekpunten, een eindige rotatie en een optioneel rond gat; verouderde rechthoekige gaten worden niet ondersteund."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବହୁଭୂଜ ପାଇଁ ଏକ ଧନାତ୍ମକ ବ୍ୟାସ, 3...12 ପୂର୍ଣ୍ଣାଙ୍କ ଶୀର୍ଷବିନ୍ଦୁ, ସୀମିତ ଘୂର୍ଣ୍ଣନ ଏବଂ ଇଚ୍ଛାଧୀନ ଗୋଲ ଗାତ ଆବଶ୍ୟକ; ପୁରୁଣା ଆୟତାକାର ଗାତଗୁଡ଼ିକ ଅସମର୍ଥିତ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਬਹੁਭੁਜ ਲਈ ਇੱਕ ਸਕਾਰਾਤਮਕ ਵਿਆਸ, 3...12 ਪੂਰਨ ਅੰਕ, ਸੀਮਤ ਘੁੰਮਣ ਅਤੇ ਵਿਕਲਪਿਕ ਗੋਲ ਛੇਕ ਦੀ ਲੋੜ ਹੁੰਦੀ ਹੈ; ਪੁਰਾਣੇ ਆਇਤਾਕਾਰ ਛੇਕ ਅਸਮਰਥਿਤ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wielokąt musi mieć dodatnią średnicę, 3–12 wierzchołków typu całkowitoliczbowego, skończony kąt obrotu oraz opcjonalny okrągły otwór; starsze prostokątne otwory nie są obsługiwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O polígono requer um diâmetro positivo, 3...12 vértices inteiros, uma rotação finita e um orifício redondo opcional; os orifícios retangulares tradicionais não são suportados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O polígono requer um diâmetro positivo, de 3 a 12 vértices inteiros, rotação finita e um orifício redondo opcional; orifícios retangulares tradicionais não são suportados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligonul trebuie să aibă un diametru pozitiv, între 3 și 12 vârfuri întregi, o rotație finită și, opțional, o gaură rotundă; găurile dreptunghiulare de tip vechi nu sunt acceptate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полигон должен иметь положительный диаметр, 3–12 целочисленных вершин, конечный угол поворота и, по желанию, круглое отверстие; устаревшие прямоугольные отверстия не поддерживаются."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "බහුඅස්‍රයට ධන විෂ්කම්භයක්, 3...12 පූර්ණ සංඛ්‍යා ශීර්ෂ, සීමිත භ්‍රමණය සහ විකල්ප වටකුරු සිදුරක් අවශ්‍ය වේ; උරුම සෘජුකෝණාස්‍රාකාර සිදුරු සඳහා සහය නොදක්වයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polygón musí mať kladný priemer, 3 až 12 celočíselných vrcholov, konečnú rotáciu a voliteľný okrúhly otvor; staršie obdĺžnikové otvory nie sú podporované."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligon mora imeti pozitiven premer, 3 do 12 celoštevilčnih oglišč, končno rotacijo in po želji okroglo luknjo; starejše pravokotne luknje niso podprte."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligoni kërkon një diametër pozitiv, kulme të plota 3...12, rrotullim të fundëm dhe një vrimë të rrumbullakët opsionale; vrimat drejtkëndëshe të trashëguara nuk mbështeten."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полигон захтева позитиван пречник, 3...12 целих врхова, коначну ротацију и опционални округли отвор; наслеђени правоугаони отвори нису подржани."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polygon kräver en positiv diameter, 3–12 heltalshörn, en ändlig rotation och ett valfritt runt hål; äldre rektangulära hål stöds inte."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembenyingi inahitaji kipenyo chanya, vipeo 3...12 vya nambari kamili, mzunguko wa mwisho na shimo la mviringo la hiari; mashimo ya mstatili ya zamani hayatumiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பலகோணத்திற்கு நேர்மறை விட்டம், 3 முதல் 12 முழு எண் முனைகள், வரையறுக்கப்பட்ட சுழற்சி மற்றும் விருப்பத்திற்கேற்ப வட்டத் துளை ஆகியவை தேவை; மரபுவழி செவ்வகத் துளைகள் ஆதரிக்கப்படவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బహుభుజికి ధనాత్మక వ్యాసం, 3...12 పూర్ణసంఖ్య శీర్షాలు, పరిమిత భ్రమణం మరియు ఐచ్ఛిక గుండ్రని రంధ్రం అవసరం; పాత దీర్ఘచతురస్రాకార రంధ్రాలకు మద్దతు లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปหลายเหลี่ยมต้องมีเส้นผ่านศูนย์กลางเป็นค่าบวก มีจุดยอดจำนวนเต็ม 3-12 จุด สามารถหมุนได้แบบจำกัด และมีรูทรงกลมเป็นตัวเลือกเสริม รูสี่เหลี่ยมผืนผ้าแบบเดิมไม่ได้รับการสนับสนุน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligon, pozitif bir çap, 3...12 tamsayı köşe noktası, sonlu bir dönme açısı ve isteğe bağlı yuvarlak delik gerektirir; eski tip dikdörtgen delikler desteklenmemektedir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полігон повинен мати додатний діаметр, 3…12 цілочисельних вершин, скінченний кут повороту та, за бажанням, круглий отвір; традиційні прямокутні отвори не підтримуються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کثیرالاضلاع کو ایک مثبت قطر، 3...12 عدد عمودی، محدود گردش اور اختیاری گول سوراخ کی ضرورت ہوتی ہے۔ میراثی مستطیل سوراخ غیر تعاون یافتہ ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đa giác yêu cầu đường kính dương, 3...12 đỉnh là số nguyên, khả năng xoay hữu hạn và lỗ tròn tùy chọn; các lỗ hình chữ nhật kiểu cũ không được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多边形要求直径为正值，具有 3...12 个整数顶点，支持有限旋转，并可选圆孔；不支持传统的矩形孔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多邊形必須具有正數直徑、3 至 12 個整數頂點、有限旋轉，且可選配圓形孔；不支援舊式的矩形孔。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-polygon idinga ububanzi obuqondile, ama-vertice angu-3...12 e-integer, ukujikeleza okulinganiselwe kanye nembobo eyindilinga yokuzikhethela; izimbobo eziyisikwele ezindala azisekelwa."
          }
        }
      }
    },
