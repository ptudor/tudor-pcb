        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "બહુકોણ માટે ધન વ્યાસ, 3...12 પૂર્ણાંક શિરોબિંદુઓ, મર્યાદિત પરિભ્રમણ અને વૈકલ્પિક ગોળ છિદ્રની જરૂર પડે છે; જૂના લંબચોરસ છિદ્રો અસમર્થિત છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצולע דורש קוטר חיובי, 3...12 קודקודים שלמים, סיבוב סופי וחור עגול אופציונלי; חורים מלבניים מדור קודם אינם נתמכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुभुज के लिए धनात्मक व्यास, 3...12 पूर्णांक शीर्ष, परिमित घूर्णन और वैकल्पिक गोलाकार छेद की आवश्यकता होती है; पुराने आयताकार छेद समर्थित नहीं हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligon zahtijeva pozitivan promjer, 3...12 cjelobrojnih vrhova, konačnu rotaciju i opcionalnu okruglu rupu; naslijeđene pravokutne rupe nisu podržane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sokszögnek pozitív átmérővel, 3–12 egész számú csúcsával, véges elforgatással és opcionális kerek nyílással kell rendelkeznie; a régi típusú téglalap alakú nyílások nem támogatottak."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բազմանկյունը պահանջում է դրական տրամագիծ, 3...12 ամբողջ թվերի գագաթներ, վերջավոր պտույտ և ըստ ցանկության կլոր անցք։ Հին ուղղանկյուն անցքերը չեն աջակցվում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligon harus memiliki diameter positif, 3...12 titik sudut bilangan bulat, rotasi terbatas, dan lubang bundar (opsional); lubang persegi panjang model lama tidak didukung."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marghyrningur krefst jákvæðs þvermáls, 3...12 heiltölupunkta, endanlegs snúnings og valfrjálsrar kringlóttrar holu; eldri rétthyrndar holur eru ekki studd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il poligono richiede un diametro positivo, da 3 a 12 vertici interi, una rotazione finita e un foro circolare facoltativo; i fori rettangolari tradizionali non sono supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポリゴンには、正の直径、3～12個の整数頂点、有限の回転、およびオプションの丸穴が必要です。従来の矩形穴はサポートされていません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პოლიგონისთვის საჭიროა დადებითი დიამეტრი, 3...12 მთელი წვეროები, სასრული ბრუნვა და სურვილისამებრ მრგვალი ხვრელი; ძველი მართკუთხა ხვრელები მხარდაუჭერელია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көпбұрыш оң диаметрді, 3...12 бүтін санды төбелерді, шекті айналуды және қосымша дөңгелек тесікті қажет етеді; ескі тікбұрышты тесіктер қолдау таппайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពហុកោណតម្រូវឱ្យមានអង្កត់ផ្ចិតវិជ្ជមាន កំពូលចំនួនគត់ 3...12 ការបង្វិលកំណត់ និងរន្ធមូលជាជម្រើស។ រន្ធចតុកោណកែងចាស់មិនត្រូវបានគាំទ្រទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬಹುಭುಜಾಕೃತಿಗೆ ಧನಾತ್ಮಕ ವ್ಯಾಸ, 3...12 ಪೂರ್ಣಾಂಕ ಶೃಂಗಗಳು, ಸೀಮಿತ ತಿರುಗುವಿಕೆ ಮತ್ತು ಐಚ್ಛಿಕ ಸುತ್ತಿನ ರಂಧ್ರದ ಅಗತ್ಯವಿದೆ; ಪರಂಪರೆಯ ಆಯತಾಕಾರದ ರಂಧ್ರಗಳು ಬೆಂಬಲಿತವಾಗಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polygon은 양의 직경, 3~12개의 정수형 꼭짓점, 유한한 회전 각도 및 선택적인 둥근 구멍을 필요로 하며, 기존 형식의 직사각형 구멍은 지원되지 않습니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көп бурчтук оң диаметрди, 3...12 бүтүн сандуу чокуларды, чектүү айланууну жана кошумча тегерек тешикти талап кылат; эски тик бурчтуу тешиктер колдоого алынбайт."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຮູບຫຼາຍຫຼ່ຽມຮຽກຮ້ອງໃຫ້ມີເສັ້ນຜ່າສູນກາງບວກ, ຈຸດຍອດຈຳນວນເຕັມ 3...12, ການໝຸນທີ່ຈຳກັດ ແລະ ຮູກົມທີ່ເປັນທາງເລືອກ; ຮູສີ່ຫຼ່ຽມມຸມສາກແບບເກົ່າແມ່ນບໍ່ຮອງຮັບ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daugiakampis turi turėti teigiamą skersmenį, 3–12 sveikųjų skaičių viršūnių, ribotą pasukimą ir (pasirinktinai) apvalią skylę; senosios stačiakampės skylės nepalaikomos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daudzstūrim ir jābūt ar pozitīvu diametru, 3–12 veseliem virsotņu skaitļiem, ierobežotai rotācijai un, pēc izvēles, apaļai atverei; vecā tipa taisnstūra formas atveres netiek atbalstītas."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полигонот бара позитивен дијаметар, цели броеви од 3...12, конечна ротација и опционална кружна дупка; старите правоаголни дупки не се поддржани."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പോളിഗണിന് പോസിറ്റീവ് വ്യാസം, 3...12 പൂർണ്ണസംഖ്യ ശീർഷകങ്ങൾ, പരിമിത ഭ്രമണം, ഓപ്ഷണൽ റൗണ്ട് ഹോൾ എന്നിവ ആവശ്യമാണ്; ലെഗസി ദീർഘചതുരാകൃതിയിലുള്ള ദ്വാരങ്ങൾക്ക് പിന്തുണയില്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Олон өнцөгт нь эерэг диаметр, 3...12 бүхэл тоон орой, хязгаарлагдмал эргэлт болон заавал сонголттой дугуй нүх шаарддаг; хуучин тэгш өнцөгт нүхнүүдийг дэмжихгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुभुजाला धन व्यास, 3 ते 12 पूर्णांक शिरोबिंदू, मर्यादित परिभ्रमण आणि ऐच्छिक गोल छिद्र आवश्यक आहे; जुन्या आयताकृती छिद्रांना समर्थन नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligon memerlukan diameter positif, 3...12 bucu integer, putaran terhingga dan lubang bulat pilihan; lubang segi empat tepat legasi tidak disokong."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poligonu jeħtieġ dijametru pożittiv, 3...12 vertiċi ta' numru sħiħ, rotazzjoni finita u toqba tonda fakultattiva; toqob rettangolari tradizzjonali mhumiex appoġġjati."
