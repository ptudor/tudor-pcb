        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polygon vaatii positiivisen halkaisijan, 3–12 kokonaislukumääräistä kärkipistettä, äärellisen kiertoliikkeen ja valinnaisen pyöreän reiän; vanhoja suorakulmaisia reikiä ei tueta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang polygon ay nangangailangan ng positibong diyametro, 3...12 integer vertices, may hangganang pag-ikot at opsyonal na bilog na butas; ang mga lumang parihabang butas ay hindi sinusuportahan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un polygone doit avoir un diamètre positif, entre 3 et 12 sommets entiers, une rotation finie et, éventuellement, un trou rond ; les trous rectangulaires traditionnels ne sont pas pris en charge."
