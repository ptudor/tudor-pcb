        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétthyrningur/ótilkryddaður krefst jákvæðrar breiddar og hæðar og valfrjálsrar kringlóttrar holu; eldri rétthyrndar holur eru ekki studd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rettangolo/ovale richiede larghezza e altezza positive e un foro rotondo facoltativo; i fori rettangolari di vecchio tipo non sono supportati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矩形/オブラウンドには、正の幅と高さおよびオプションの丸穴が必要です。従来の矩形穴はサポートされていません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მართკუთხა/მრგვალი ფორმის ხვრელებისთვის საჭიროა დადებითი სიგანე და სიმაღლე და სურვილისამებრ მრგვალი ხვრელი; ძველი მართკუთხა ხვრელები არ არის მხარდაჭერილი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіктөртбұрыш/дөңес пішін оң ені мен биіктігін және қосымша дөңгелек тесікті қажет етеді; ескі тіктөртбұрышты тесіктер қолдау таппайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចតុកោណកែង/រាងពងក្រពើ តម្រូវឱ្យមានទទឹង និងកម្ពស់វិជ្ជមាន និងរន្ធមូលជាជម្រើស។ រន្ធចតុកោណកែងចាស់ៗមិនត្រូវបានគាំទ្រទេ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಯತ/ಹೊರಭಾಗಕ್ಕೆ ಧನಾತ್ಮಕ ಅಗಲ ಮತ್ತು ಎತ್ತರ ಮತ್ತು ಐಚ್ಛಿಕ ಸುತ್ತಿನ ರಂಧ್ರದ ಅಗತ್ಯವಿದೆ; ಪರಂಪರೆಯ ಆಯತಾಕಾರದ ರಂಧ್ರಗಳು ಬೆಂಬಲಿತವಾಗಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직사각형/타원형 구멍의 경우 너비와 높이를 양수 값으로 지정해야 하며, 원형 구멍은 선택 사항입니다. 기존 형식의 직사각형 구멍은 지원되지 않습니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тик бурчтук/тегерек форма оң туурасын жана бийиктигин, ошондой эле кошумча тегерек тешикти талап кылат; эски тик бурчтуу тешиктер колдоого алынбайт."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຮູບສີ່ແຈສາກ/ຮູບຊົງກົມຕ້ອງການຄວາມກວ້າງ ແລະ ຄວາມສູງເປັນບວກ ແລະ ມີຮູຮູບຊົງກົມເປັນທາງເລືອກ; ຮູຮູບສີ່ແຈສາກແບບເກົ່າແມ່ນບໍ່ຮອງຮັບ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačiakampio ar apvalaus stačiakampio formos skylėms būtina nurodyti teigiamus pločio ir aukščio dydžius bei pasirinktinai – apvalią skylę; senosios stačiakampės skylės nepalaikomos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taisnstūrim/ovālajam izgriezumam ir jānorāda pozitīvs platums un augstums, kā arī, pēc izvēles, apaļs caurums; vecā tipa taisnstūra caurumi netiek atbalstīti."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правоаголникот/заоблениот отвор бара позитивна ширина и висина и опционален кружен отвор; старите правоаголни отвори не се поддржани."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ദീർഘചതുരം/വൃത്താകൃതിക്ക് പോസിറ്റീവ് വീതിയും ഉയരവും ഓപ്ഷണൽ വൃത്താകൃതിയിലുള്ള ദ്വാരവും ആവശ്യമാണ്; പരമ്പരാഗത ദീർഘചതുരാകൃതിയിലുള്ള ദ്വാരങ്ങൾക്ക് പിന്തുണയില്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тэгш өнцөгт/төвлөрсөн хэлбэрт эерэг өргөн ба өндөр, мөн сонголттой дугуй нүх шаардлагатай; хуучин тэгш өнцөгт нүхнүүдийг дэмжихгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आयताकृती/ओबडाकृती छिद्रासाठी धन रुंदी आणि उंची तसेच ऐच्छिक गोल छिद्र आवश्यक आहे; जुन्या पद्धतीची आयताकृती छिद्रे समर्थित नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segi empat tepat/bulat memerlukan lebar dan tinggi positif serta lubang bulat pilihan; lubang segi empat tepat legasi tidak disokong."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rettangolari/obround jeħtieġ wisa' u għoli pożittivi u toqba tonda fakultattiva; toqob rettangolari tradizzjonali mhumiex appoġġjati."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထောင့်မှန်စတုဂံ/အဝိုင်းသည် အပေါင်းအကျယ်နှင့် အမြင့်အပြင် ရွေးချယ်နိုင်သော အဝိုင်းအပေါက် လိုအပ်ပြီး အဟောင်းထောင့်အပေါက်များကို ပံ့ပိုးမထားပါ။"
          }
        },
        "nb" : {
