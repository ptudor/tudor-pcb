        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku kształtu prostokątnego/owalnego wymagane jest podanie dodatniej szerokości i wysokości oraz opcjonalnego okrągłego otworu; starsze prostokątne otwory nie są obsługiwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O retângulo/retângulo arredondado requer largura e altura positivas e um orifício redondo opcional; os orifícios retangulares antigos não são suportados."
