          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éilíonn polagán trastomhas dearfach, 3...12 buaicphointe slánuimhreacha, rothlú críochta agus poll cruinn roghnach; ní thacaítear le poill dhronuilleogacha seanré."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O polígono require un diámetro positivo, de 3 a 12 vértices enteiros, rotación finita e un burato redondo opcional; os buratos rectangulares herdados non son compatibles."
