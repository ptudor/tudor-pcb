        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правоугаоник/заобљени захтева позитивну ширину и висину и опционално округли отвор; наслеђени правоугаони отвори нису подржани."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rektangel/oval kräver positiva värden för bredd och höjd samt ett valfritt runt hål; äldre rektangulära hål stöds inte."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mstatili/mviringo unahitaji upana na urefu chanya na shimo la mviringo la hiari; mashimo ya mstatili ya zamani hayatumiki."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "செவ்வகம்/நீள்வட்டத்திற்கு நேர்மறை அகலமும் உயரமும், மற்றும் விருப்பத்திற்கேற்ப வட்டத் துளையும் தேவை; பழைய செவ்வகத் துளைகளுக்கு ஆதரவு இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దీర్ఘచతురస్రం/అండాకారానికి ధనాత్మక వెడల్పు మరియు ఎత్తు మరియు ఐచ్ఛిక గుండ్రని రంధ్రం అవసరం; పాత దీర్ఘచతురస్రాకార రంధ్రాలకు మద్దతు లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปทรงสี่เหลี่ยมผืนผ้า/สี่เหลี่ยมผืนผ้าต้องมีค่าความกว้างและความสูงเป็นค่าบวก และอาจมีรูตรงกลางเป็นทรงกลมได้ รูสี่เหลี่ยมผืนผ้าแบบเดิมไม่รองรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikdörtgen/yuvarlak dikdörtgen için pozitif genişlik ve yükseklik değerleri ve isteğe bağlı yuvarlak delik gereklidir; eski tip dikdörtgen delikler desteklenmemektedir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для прямокутника/овалу необхідні додатні значення ширини та висоти, а також опціональний круглий отвір; застарілі прямокутні отвори не підтримуються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستطیل/اوبراونڈ کے لیے مثبت چوڑائی اور اونچائی اور اختیاری گول سوراخ کی ضرورت ہوتی ہے۔ میراثی مستطیل سوراخ غیر تعاون یافتہ ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình chữ nhật/hình bầu dục yêu cầu chiều rộng và chiều cao dương và lỗ tròn tùy chọn; các lỗ hình chữ nhật kiểu cũ không được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矩形/椭圆形需要指定正的宽度和高度，并可选填圆孔；旧式的矩形孔不被支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矩形／橢圓形需指定正數的寬度和高度，並可選配圓形孔；舊式矩形孔已不再支援。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unxande/oyindilinga udinga ububanzi nokuphakama okuhle kanye nomgodi oyindilinga ongawukhetha; izimbobo eziyisikwele ezindala azisekelwa."
          }
        }
      }
    },
