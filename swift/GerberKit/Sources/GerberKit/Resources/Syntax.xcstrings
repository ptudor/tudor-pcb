        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പിന്തുണയ്ക്കാത്ത ഡ്രോ അപ്പർച്ചർ; സോളിഡ് സർക്കിളുകളും ലീനിയർ ലെഗസി റെക്ടാം സ്വീപ്പുകളും മാത്രമേ പിന്തുണയ്ക്കൂ."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дэмжигдээгүй зурах диафрагм; зөвхөн цул тойрог болон шугаман уламжлалт тэгш өнцөгтийн самналтыг дэмждэг."
          }
        },
        "mr" : {
