        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تک مستقل رسائی دستیاب نہیں ہے۔ اصل فائل یا فولڈر کو دوبارہ لنک کرنے کے لیے اسے دوبارہ منتخب کریں۔"
