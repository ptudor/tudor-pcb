        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুনরুদ্ধারের সময় ইতিহাস পরিবর্তিত হয়েছে। পুনরায় পুনরুদ্ধার বেছে নেওয়ার আগে এটি পুনরায় লোড করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
