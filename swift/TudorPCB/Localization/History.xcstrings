        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ની ઍક્સેસ પુનઃસ્થાપિત કરી શકાઈ નથી: %2$@ સ્રોતને ફરીથી લિંક કરવા માટે તેને ફરીથી પસંદ કરો."
