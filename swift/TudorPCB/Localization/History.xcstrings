        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לשחזר את הגישה ל-%1$@: %2$@ בחר מחדש את המקור כדי לקשר אותו מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
