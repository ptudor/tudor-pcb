          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୂଳ ଡାଟା ସଂରକ୍ଷିତ ଅଛି; ଆପଣ ପୁନରୁଦ୍ଧାର ବାଛିବା ପର୍ଯ୍ୟନ୍ତ ସେଭ୍ କରିବା ବିରତ ଅଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੂਲ ਡਾਟਾ ਸੁਰੱਖਿਅਤ ਰੱਖਿਆ ਜਾਂਦਾ ਹੈ; ਸੇਵਿੰਗ ਉਦੋਂ ਤੱਕ ਰੋਕ ਦਿੱਤੀ ਜਾਂਦੀ ਹੈ ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਰਿਕਵਰੀ ਨਹੀਂ ਚੁਣਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oryginalne dane zostają zachowane; zapisywanie zostaje wstrzymane do momentu wybrania opcji odzyskiwania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados originais são preservados; o processo de gravação fica em pausa até que opte pela recuperação."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
