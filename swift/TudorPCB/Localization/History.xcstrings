        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ზე წვდომის აღდგენა ვერ მოხერხდა: %2$@ ხელახლა დასაკავშირებლად ხელახლა აირჩიეთ წყარო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ кіруді қалпына келтіру мүмкін болмады: %2$@ Қайта байланыстыру үшін дереккөзді қайта таңдаңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មិនអាចស្ដារការចូលប្រើ %1$@ បានទេ : %2$@ សូមជ្រើសរើសប្រភពឡើងវិញដើម្បីភ្ជាប់វាឡើងវិញ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಗೆ ಪ್ರವೇಶವನ್ನು ಮರುಸ್ಥಾಪಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %2$@ ಅದನ್ನು ಮರುಲಿಂಕ್ ಮಾಡಲು ಮೂಲವನ್ನು ಮರು ಆಯ್ಕೆ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 대한 액세스를 복원할 수 없습니다: %2$@ 소스를 다시 선택하여 연결을 다시 설정하십시오."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ кирүү мүмкүнчүлүгүн калыбына келтирүү мүмкүн болгон жок : %2$@ Кайра шилтемелөө үчүн булакты кайра тандаңыз."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບໍ່ສາມາດກູ້ຄືນການເຂົ້າເຖິງ %1$@ ໄດ້ : %2$@ ເລືອກແຫຼ່ງຂໍ້ມູນຄືນໃໝ່ເພື່ອເຊື່ອມໂຍງມັນຄືນໃໝ່."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko atkurti prieigos prie „%1$@“: %2$@. Norėdami vėl susieti šaltinį, pasirinkite jį iš naujo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās atjaunot piekļuvi vietnei %1$@: %2$@ Izvēlieties avotu no jauna, lai to atkārtoti piesaistītu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не може да се врати пристапот до %1$@: %2$@ Изберете го изворот повторно за да го поврзете повторно."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ലേക്കുള്ള ആക്‌സസ് പുനഃസ്ഥാപിക്കാൻ കഴിഞ്ഞില്ല : %2$@ വീണ്ടും ലിങ്ക് ചെയ്യുന്നതിന് ഉറവിടം വീണ്ടും തിരഞ്ഞെടുക്കുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ руу хандах эрхийг сэргээж чадсангүй : %2$@ Дахин холбохын тулд эх сурвалжийг дахин сонгоно уу."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ चा ऍक्सेस पूर्ववत करता आला नाही: %2$@ त्याला पुन्हा लिंक करण्यासाठी स्त्रोत पुन्हा निवडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memulihkan akses kepada %1$@: %2$@ Pilih semula sumber untuk memautkannya semula."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma setax jiġi restawrat l-aċċess għal %1$@: %2$@ Agħżel mill-ġdid is-sors biex terġa' tgħaqqdu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ သို့ ဝင်ရောက်ခွင့်ကို ပြန်လည်ရယူ၍မရပါ : %2$@ ရင်းမြစ်ကို ပြန်လည်လင့်ခ်ချိတ်ရန် ပြန်လည်ရွေးချယ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var ikke mulig å gjenopprette tilgangen til %1$@: %2$@ Velg kilden på nytt for å koble den til igjen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ मा पहुँच पुनर्स्थापित गर्न सकिएन: %2$@ पुन: लिङ्क गर्न स्रोत पुन: चयन गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toegang tot %1$@ kon niet worden hersteld: %2$@ Selecteer de bron opnieuw om de koppeling te herstellen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ କୁ ପ୍ରବେଶ ପୁନଃସ୍ଥାପିତ କରିପାରିଲା ନାହିଁ : %2$@ ଏହାକୁ ପୁନଃଲିଙ୍କ୍ କରିବା ପାଇଁ ଉତ୍ସକୁ ପୁନଃ ଚୟନ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ਤੱਕ ਪਹੁੰਚ ਮੁੜ-ਬਹਾਲ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ: %2$@ ਸਰੋਤ ਨੂੰ ਦੁਬਾਰਾ ਲਿੰਕ ਕਰਨ ਲਈ ਇਸਨੂੰ ਮੁੜ-ਚੁਣੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przywrócić dostępu do %1$@: %2$@ Wybierz ponownie źródło, aby je ponownie połączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível restabelecer o acesso a %1$@: %2$@. Volte a selecionar a fonte para restabelecer a ligação."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível restaurar o acesso a %1$@: %2$@. Selecione novamente a fonte para vinculá-la novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut restabili accesul la %1$@: %2$@. Alegeți din nou sursa pentru a o reconecta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось восстановить доступ к %1$@: %2$@. Выберите источник заново, чтобы повторно установить связь."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ වෙත ප්‍රවේශය ප්‍රතිසාධනය කළ නොහැකි විය : %2$@ එය නැවත සම්බන්ධ කිරීමට මූලාශ්‍රය නැවත තෝරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa obnoviť prístup k položke %1$@: %2$@ Znovu vyberte zdroj, aby ste ho opäť prepojili."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop do %1$@ ni bil mogoče obnoviti: %2$@ Ponovno izberite vir, da ga ponovno povežete."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk mund të rivendoste qasjen në %1$@: %2$@ Zgjidh përsëri burimin për ta rilidhur atë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Није могуће обновити приступ %1$@: %2$@ Поново изаберите извор да бисте га поново повезали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att återställa åtkomsten till %1$@: %2$@ Välj källan på nytt för att länka om den."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haikuweza kurejesha ufikiaji wa %1$@ : %2$@ Chagua chanzo upya ili kukiunganisha tena."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : %2$@ க்கான அணுகலை மீட்டெடுக்க முடியவில்லை. அதை மீண்டும் இணைக்க மூலத்தை மீண்டும் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : %2$@ కు యాక్సెస్‌ను పునరుద్ధరించలేకపోయింది, దాన్ని తిరిగి లింక్ చేయడానికి మూలాన్ని మళ్లీ ఎంచుకోండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถกู้คืนการเข้าถึง %1$@ ได้: %2$@ โปรดเลือกแหล่งที่มาอีกครั้งเพื่อเชื่อมโยงใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ adresine erişim geri yüklenemedi: %2$@ Kaynağı yeniden seçerek bağlantıyı yeniden kurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося відновити доступ до %1$@: %2$@. Виберіть джерело ще раз, щоб повторно встановити зв’язок."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ تک رسائی بحال نہیں ہو سکی : %2$@ دوبارہ لنک کرنے کے لیے ماخذ کو دوبارہ منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khôi phục quyền truy cập vào %1$@: %2$@ Hãy chọn lại nguồn để liên kết lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法恢复对 %1$@ 的访问：%2$@ 请重新选择源以重新建立链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法恢復對 %1$@ 的存取權限：%2$@ 請重新選取來源以重新建立連結。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayikwazanga ukubuyisela ukufinyelela ku-%1$@: %2$@ Khetha kabusha umthombo ukuze uwuxhumanise kabusha."
          }
        }
      }
    },
