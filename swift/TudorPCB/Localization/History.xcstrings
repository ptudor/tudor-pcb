            "value" : "%1$@ तक पहुंच बहाल नहीं हो सकी: %2$@ इसे पुनः लिंक करने के लिए स्रोत का पुनः चयन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije moguće vratiti pristup %1$@: %2$@ Ponovno odaberite izvor za ponovno povezivanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült visszaállítani a hozzáférést a %1$@ webhelyhez: %2$@ Válassza ki újra a forrást az újracsatlakozáshoz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հնարավոր չէ վերականգնել %1$@ ին մուտքը։ %2$@ Վերընտրեք աղբյուրը՝ այն վերահղելու համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memulihkan akses ke %1$@: %2$@ Pilih kembali sumbernya untuk menghubungkannya kembali."
