    "Back Up Original and Recover Valid History" : {
      "comment" : "Alert button that keeps a copy of the damaged history and continues with the records that could be read.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rugsteun Oorspronklike en Herstel Geldige Geskiedenis"
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የመጀመሪያውን ምትኬ ያስቀምጡ እና ትክክለኛ ታሪክን መልሰው ያግኙ"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ الأصل احتياطيًا واستعادة السجلات الصالحة"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinalın ehtiyat nüsxəsini çıxarın və etibarlı tarixçəni bərpa edin"
          }
        },
        "be" : {
          "stringUnit" : {
