    "History changed during recovery. Reload it before choosing recovery again." : {
      "comment" : "Error shown when the saved history was modified (for example by another window) between reading it and repairing it.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geskiedenis het tydens herstel verander. Herlaai dit voordat u herstel weer kies."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በማገገሚያ ወቅት ታሪክ ተቀይሯል። መልሶ ማግኛን እንደገና ከመምረጥዎ በፊት እንደገና ይጫኑት።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغير السجل أثناء الاستعادة. أعد تحميله قبل اختيار الاستعادة مجددًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bərpa zamanı tarixçə dəyişdi. Yenidən bərpa seçməzdən əvvəl onu yenidən yükləyin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гісторыя змянілася падчас аднаўлення. Перазагрузіце яе, перш чым зноў выбраць аднаўленне."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
