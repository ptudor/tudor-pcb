          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele originale sunt păstrate; salvarea este suspendată până când alegeți opțiunea de recuperare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исходные данные сохраняются; процесс сохранения приостанавливается до тех пор, пока вы не выберете вариант восстановления."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මුල් දත්ත සංරක්ෂිත වේ; ඔබ ප්‍රතිසාධනය තෝරා ගන්නා තෙක් සුරැකීම විරාම කර ඇත."
          }
        },
        "sk" : {
