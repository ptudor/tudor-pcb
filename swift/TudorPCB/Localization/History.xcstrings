    "The package opened, but persistent access could not be saved: %@ Reselect the source to retry." : {
      "comment" : "Message shown when a package opened but the app could not save permission to reopen it later from history. %@ is the operating system's description of the problem (a full sentence ending with a period).",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die pakket het oopgemaak, maar volgehoue toegang kon nie gestoor word nie: %@ Herkies die bron om weer te probeer."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፓኬጁ ተከፍቷል፣ ነገር ግን የማያቋርጥ መዳረሻ ሊቀመጥ አልቻለም: %@ እንደገና ለመሞከር ምንጩን እንደገና ይምረጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم فتح الحزمة، ولكن تعذر حفظ الوصول الدائم: %@ أعد تحديد المصدر لإعادة المحاولة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket açıldı, lakin davamlı giriş yadda saxlanıla bilmədi: %@ Yenidən cəhd etmək üçün mənbəyi yenidən seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет адкрыўся, але пастаянны доступ не ўдалося захаваць: %@ Зноў выберыце крыніцу, каб паўтарыць спробу."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакетът се отвори, но постоянният достъп не бе запазен: %@ Изберете пак източника за нов опит."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাকেজটি খোলা হয়েছে, কিন্তু স্থায়ী অ্যাক্সেস সংরক্ষণ করা যায়নি: %@ পুনরায় চেষ্টা করতে উৎসটি আবার নির্বাচন করুন।"
