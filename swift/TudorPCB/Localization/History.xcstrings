    "Could not restore access to %@: %@ Reselect the source to relink it." : {
      "comment" : "Message shown when reopening a package from history fails. %1$@ is the file or folder path, %2$@ is the operating system's description of the problem (a full sentence ending with a period).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not restore access to %1$@: %2$@ Reselect the source to relink it."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon nie toegang tot %1$@ herstel nie: %2$@ Kies die bron weer om dit weer te koppel."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወደ %1$@ መዳረሻን ወደነበረበት መመለስ አልተቻለም፡ %2$@ እንደገና ለማገናኘት ምንጩን እንደገና ይምረጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر استعادة الوصول إلى %1$@ : %2$@ أعد تحديد المصدر لإعادة ربطه."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ -a girişi bərpa etmək mümkün olmadı: %2$@ Yenidən əlaqələndirmək üçün mənbəni yenidən seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не атрымалася аднавіць доступ да %1$@: %2$@ Зноў выберыце крыніцу, каб узнавіць сувязь."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не беше възможно да се възстанови достъпът до %1$@: %2$@ Изберете отново източника, за да го свържете отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : %2$@ তে অ্যাক্সেস পুনরুদ্ধার করা যায়নি। এটিকে পুনরায় লিঙ্ক করতে উৎসটি আবার নির্বাচন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut restaurar l'accés a %1$@ : %2$@ Torneu a seleccionar la font per tornar-la a enllaçar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se obnovit přístup k adrese %1$@: %2$@ Znovu vyberte zdroj a znovu jej propojte."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Methu adfer mynediad i %1$@: %2$@ Ail-ddewiswch y ffynhonnell i'w hailgysylltu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var ikke muligt at genoprette adgangen til %1$@: %2$@ Vælg kilden igen for at oprette forbindelsen på ny."
          }
        },
        "de" : {
          "stringUnit" : {
