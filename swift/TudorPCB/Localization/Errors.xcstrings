    "Could not encode a Metal frame. Retry the 3D display." : {
      "comment" : "3D display error: drawing one frame failed; the user can press Retry. 'Metal' is Apple's graphics technology; keep it as written.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
