        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს მიწოდება შეიცავს რამდენიმე დაფის კომპლექტს. აირჩიეთ წყაროს გზა შესამოწმებლად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл жеткізілімде бірнеше тақта жиынтығы бар. Тексерілетін бастапқы жолды таңдаңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការដឹកជញ្ជូននេះមានសំណុំក្តារជាច្រើន។ ជ្រើសរើសផ្លូវប្រភពដើម្បីត្រួតពិនិត្យ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ವಿತರಣೆಯು ಹಲವಾರು ಬೋರ್ಡ್ ಸೆಟ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿದೆ. ಪರಿಶೀಲಿಸಲು ಮೂಲ ಮಾರ್ಗವನ್ನು ಆರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 배송물에는 여러 개의 보드 세트가 포함되어 있습니다. 확인할 소스 경로를 선택하십시오."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бул жеткирүүдө бир нече такта топтому камтылган. Текшерүү үчүн булак жолун тандаңыз."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຈັດສົ່ງນີ້ປະກອບມີຊຸດກະດານຫຼາຍຊຸດ. ເລືອກເສັ້ນທາງແຫຼ່ງຂໍ້ມູນເພື່ອກວດສອບ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
