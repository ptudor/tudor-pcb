        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለመዞር ይጎትቱ · ለማጉላት ይሸብልሉ ወይም ይቆንጥጡ · ለመገጣጠም ሁለቴ ጠቅ ያድርጉ"
