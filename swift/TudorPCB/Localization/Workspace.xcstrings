        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluoksnių išsamumas, gręžimo registracija ir tinkamumas gamybai nebuvo patikrinti. Patikrinkite importo įspėjimus ir sluoksnių rodymo apribojimus."
