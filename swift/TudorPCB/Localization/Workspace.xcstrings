        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geruzen osotasuna, zulagailuaren erregistroa eta fabrikazio egokitasuna ez dira egiaztatu. Egiaztatu inportazio abisuak eta geruzen bistaratze mugak."
