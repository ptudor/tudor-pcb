    "Adjust to zoom. Camera controls also provide top, bottom, and fit views." : {
      "comment" : "Accessibility hint for the 3D board view on iPhone and iPad: swiping up or down with VoiceOver zooms, and the toolbar has Top, Bottom, and Fit buttons.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas aan om te zoom. Kamerakontroles bied ook bo-, onder- en pas-aanbod-aansigte."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለማጉላት ያስተካክሉ። የካሜራ መቆጣጠሪያዎች የላይኛውን፣ የታችኛውን እና የመገጣጠም እይታዎችንም ይሰጣሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط خاصية التكبير/التصغير. كما توفر عناصر التحكم بالكاميرا إمكانية عرض من الأعلى والأسفل والداخل."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Böyütmək üçün tənzimləyin. Kamera idarəetmələri həmçinin yuxarı, aşağı və uyğun görünüşlər təmin edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрэгулюйце маштаб. Элементы кіравання камерай таксама забяспечваюць від зверху, знізу і па памеры."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте мащабирането. Управлението на камерата предлага също изгледи „отгоре“, „отдолу“ и „по размер“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জুম করতে অ্যাডজাস্ট করুন। ক্যামেরা কন্ট্রোল টপ, বটম এবং ফিট ভিউও প্রদান করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta per fer zoom. Els controls de la càmera també proporcionen vistes superior, inferior i ajustada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobte zobrazení podle přiblížení. Ovládací prvky kamery také umožňují zobrazení nahoře, dole a přizpůsobení obrazu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addaswch i chwyddo. Mae rheolyddion y camera hefyd yn darparu golygfeydd uchaf, gwaelod, a ffit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster for at zoome. Kamerakontrollerne giver også mulighed for visning øverst, nederst og tilpasning til skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen anpassen. Über die Kamerasteuerung stehen außerdem die Ansichten „Oben“, „Unten“ und „Anpassen“ zur Verfügung."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen anpassen. Kamerasteuerungen bieten außerdem Ansichten von oben, unten und angepasst."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen anpassen. Die Kamerasteuerung bietet außerdem Ansichten von oben, unten und im Bildausschnitt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόστε για μεγέθυνση. Τα στοιχεία ελέγχου της κάμερας παρέχουν επίσης προβολές «πάνω», «κάτω» και «προσαρμογή»."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust to zoom. Camera controls also provide top, bottom, and fit views."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust to zoom. Camera controls also provide top, bottom, and fit views."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust to zoom. Camera controls also provide top, bottom, and fit views."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el zoom. Los controles de la cámara también permiten seleccionar las vistas «superior», «inferior» y «ajustar a la pantalla»."
          }
        },
        "es-AR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el zoom. Los controles de la cámara también ofrecen las vistas superior, inferior y de ajuste a pantalla."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el zoom. Los controles de la cámara también ofrecen vistas superior, inferior y de ajuste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurenda või vähenda pilti. Kaamera juhtnuppudega saab valida ka ülevalt, alt ja ekraani suurusele kohandatud vaateid."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doitu zooma egiteko. Kameraren kontrolak goiko, beheko eta doikuntzako ikuspegiak ere eskaintzen dituzte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بزرگنمایی تنظیم کنید. کنترل‌های دوربین همچنین نماهای بالا، پایین و متناسب را ارائه می‌دهند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä zoomausta. Kameran säätimillä voi valita myös ylä-, ala- ja sovitusnäkymän."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-adjust para mag-zoom. Nagbibigay din ang mga kontrol ng camera ng mga view sa itaas, ibaba, at pagkakasya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le zoom. Les commandes de la caméra permettent également d'afficher les vues « haut », « bas » et « ajustée »."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le zoom. Les commandes de la caméra permettent également d'accéder aux vues de dessus, de dessous et ajustée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coigeartaigh chun súmáil isteach. Soláthraíonn rialuithe ceamara radhairc barr, bun agus oiriúnaithe freisin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Axustar para ampliar. Os controis da cámara tamén ofrecen vistas superior, inferior e axustada."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઝૂમ કરવા માટે ગોઠવો. કેમેરા નિયંત્રણો ઉપર, નીચે અને ફિટ દૃશ્યો પણ પ્રદાન કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כוונון לזום. פקדי המצלמה מספקים גם תצוגות מלמעלה, למטה והתאמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़ूम को समायोजित करें। कैमरा नियंत्रणों में ऊपर, नीचे और साइड व्यू भी दिए गए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite zumiranje. Kontrole kamere također pružaju prikaze odozgo, odozdo i po mjeri."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nagyításhoz állítsa be a méretet. A kamera vezérlőivel felső, alsó és képernyőhöz igazított nézetek is elérhetők."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կարգավորեք մեծացումը։ Տեսախցիկի կառավարման տարրերը նաև ապահովում են վերևից, ներքևից և համապատասխան տեսք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan untuk memperbesar. Kontrol kamera juga menyediakan tampilan atas, bawah, dan sesuai."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stilla aðdrátt. Stýringar myndavélarinnar bjóða einnig upp á yfirsýn að ofan, neðan og að aðdrátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola lo zoom. I comandi della fotocamera consentono inoltre di visualizzare l'immagine dall'alto, dal basso e adattata allo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ズームに合わせて調整してください。カメラの操作機能では、上部表示、下部表示、フィット表示も利用できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მასშტაბირებისთვის მორგება. კამერის მართვის საშუალებები ასევე უზრუნველყოფს ზედა, ქვედა და მორგებულ ხედებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштабтау үшін реттеңіз. Камера басқару элементтері сонымен қатар жоғарғы, төменгі және сәйкес көріністерді қамтамасыз етеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "កែសម្រួលដើម្បីពង្រីក។ ការគ្រប់គ្រងកាមេរ៉ាក៏ផ្តល់នូវទិដ្ឋភាពកំពូល បាត និងសមផងដែរ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಝೂಮ್‌ಗೆ ಹೊಂದಿಸಿ. ಕ್ಯಾಮೆರಾ ನಿಯಂತ್ರಣಗಳು ಮೇಲೆ, ಕೆಳಗೆ ಮತ್ತು ಹೊಂದಿಕೊಳ್ಳುವ ವೀಕ್ಷಣೆಗಳನ್ನು ಸಹ ಒದಗಿಸುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확대/축소하여 화면을 조정하세요. 카메라 제어 기능을 통해 상단, 하단 및 화면 전체에 맞추기 보기도 사용할 수 있습니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чоңойтуу үчүн тууралаңыз. Камеранын башкаруу элементтери ошондой эле жогору, төмөн жана туура көрүнүштөрдү камсыз кылат."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ປັບເພື່ອຊູມ. ການຄວບຄຸມກ້ອງຖ່າຍຮູບຍັງໃຫ້ມຸມມອງດ້ານເທິງ, ດ້ານລຸ່ມ ແລະ ມຸມເບິ່ງທີ່ພໍດີ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritaikyti pagal mastelį. Kameros valdymo elementai taip pat leidžia peržiūrėti vaizdą iš viršaus, iš apačios ir pritaikyti vaizdą prie ekrano."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pielāgojiet, lai mainītu tālummaiņu. Kameras vadības elementi nodrošina arī skatus „no augšas”, „no apakšas” un „pielāgot skatu”."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагодете за зумирање. Контролите на камерата исто така овозможуваат прикази одозгора, одоздола и прилагодување."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സൂം ചെയ്യാൻ ക്രമീകരിക്കുക. ക്യാമറ നിയന്ത്രണങ്ങൾ മുകളിലേക്കും താഴേക്കും ഫിറ്റ് കാഴ്ചകളും നൽകുന്നു."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Томруулахын тулд тохируулна уу. Камерын удирдлага нь дээр, доор болон тохирох харагдацыг мөн хангадаг."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झूम करण्यासाठी समायोजित करा. कॅमेरा नियंत्रणे वरून, खालून आणि फिट व्ह्यू देखील प्रदान करतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laraskan untuk zum. Kawalan kamera juga menyediakan paparan atas, bawah dan sesuai."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aġġusta biex tiżżumja. Il-kontrolli tal-kamera jipprovdu wkoll veduti minn fuq, minn isfel, u tajbin."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zoom ချိန်ညှိပါ။ ကင်မရာထိန်းချုပ်မှုများသည် အပေါ်၊ အောက်နှင့် အံဝင်ခွင်ကျမြင်ကွင်းများကိုလည်း ပေးပါသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster for å zoome. Kamerakontrollene gir også mulighet for visning øverst, nederst og tilpasset skjermstørrelse."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जुममा समायोजन गर्नुहोस्। क्यामेरा नियन्त्रणहरूले माथि, तल र फिट दृश्यहरू पनि प्रदान गर्दछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de weergave aan om in te zoomen. Met de camerabediening kunt u ook kiezen uit weergaven bovenaan, onderaan en ‘op maat’."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଜୁମ୍ ସହିତ ଆଡଜଷ୍ଟ କରନ୍ତୁ। କ୍ୟାମେରା ନିୟନ୍ତ୍ରଣଗୁଡ଼ିକ ଉପର, ତଳ ଏବଂ ଫିଟ୍ ଦୃଶ୍ୟ ମଧ୍ୟ ପ୍ରଦାନ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜ਼ੂਮ ਕਰਨ ਲਈ ਐਡਜਸਟ ਕਰੋ। ਕੈਮਰਾ ਕੰਟਰੋਲ ਉੱਪਰ, ਹੇਠਾਂ, ਅਤੇ ਫਿੱਟ ਦ੍ਰਿਸ਼ ਵੀ ਪ੍ਰਦਾਨ ਕਰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj powiększenie. Elementy sterujące aparatu umożliwiają również wyświetlanie widoku górnego, dolnego oraz dopasowanego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste para ampliar. Os controlos da câmara também permitem visualizar as imagens na parte superior, na parte inferior e ajustadas ao ecrã."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o zoom. Os controles da câmera também oferecem as visualizações “superior”, “inferior” e “ajustar à tela”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reglați pentru a mări imaginea. Comenzile camerei oferă, de asemenea, opțiunile de vizualizare „sus”, „jos” și „potrivire”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте масштаб. Среди элементов управления камерой также доступны режимы просмотра «Сверху», «Снизу» и «По размеру»."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "විශාලනයට සකසන්න. කැමරා පාලන ඉහළ, පහළ සහ ගැළපෙන දසුන් ද සපයයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prispôsobte si zväčšenie. Ovládacie prvky kamery ponúkajú aj zobrazenie zhora, zdola a prispôsobenie obrazu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite povečavo. Nadzorne funkcije kamere omogočajo tudi pogled od zgoraj, od spodaj in prilagajanje slike."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rregullo për zmadhim. Kontrollet e kamerës ofrojnë gjithashtu pamje nga lart, poshtë dhe të përshtatura."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагодите за зумирање. Контроле камере такође пружају приказе одозгоре, одоздо и прилагођене."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera för att zooma. Kamerakontrollerna erbjuder även vyer uppifrån, nedifrån och anpassad vy."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekebisha ili kukuza. Vidhibiti vya kamera pia hutoa mionekano ya juu, chini, na inayofaa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெரிதாக்க சரிசெய்யவும். கேமரா கட்டுப்பாடுகள் மேல், கீழ் மற்றும் பொருத்தமான காட்சிகளையும் வழங்குகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జూమ్‌ను సర్దుబాటు చేసుకోండి. కెమెరా నియంత్రణలు టాప్, బాటమ్ మరియు ఫిట్ వ్యూస్‌ను కూడా అందిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับระดับการซูม นอกจากนี้ การควบคุมกล้องยังให้มุมมองจากด้านบน ด้านล่าง และแบบปรับให้พอดีกับหน้าจอได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınlaştırma için ayarlayın. Kamera kontrolleri ayrıca üst, alt ve sığdırma görünümleri sunar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте масштаб. Елементи керування камерою також дозволяють переглядати верхню, нижню та адаптивну сторони."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زوم کو ایڈجسٹ کریں۔ کیمرہ کنٹرول اوپر، نیچے اور فٹ ویوز بھی فراہم کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh để phóng to. Các nút điều khiển máy ảnh cũng cung cấp các chế độ xem từ trên, từ dưới và phù hợp với màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整以进行缩放。相机控制功能还提供顶部、底部和适应视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整以進行縮放。相機控制功能還提供「頂部」、「底部」及「適應畫面」視圖。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lungisa ukuze usondeza. Izilawuli zekhamera ziphinde zinikeze ukubuka okuphezulu, phansi, kanye nokulingana."
          }
        }
      }
    },
