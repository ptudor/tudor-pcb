                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld layers"
                }
              }
            }
          }
        }
      }
    },
    "%lld objects" : {
      "comment" : "Part of the package summary line. %lld is the number of drawn shapes across all layers (plural forms are provided).",
      "localizations" : {
