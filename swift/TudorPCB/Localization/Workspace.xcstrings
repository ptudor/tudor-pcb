        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرت کی تکمیل، ڈرل رجسٹریشن، اور مینوفیکچرنگ کی مناسبیت کی تصدیق نہیں کی گئی ہے۔ درآمدی انتباہات اور پرت ڈسپلے کی حدود کو چیک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ hoàn thiện của lớp, độ chính xác khi khoan và tính phù hợp để sản xuất chưa được xác minh. Kiểm tra cảnh báo nhập khẩu và giới hạn hiển thị lớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未验证图层完整性、钻孔对位和制造适用性。请检查导入警告和图层显示限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未驗證圖層完整性、鑽孔對位及製造適用性。請檢查匯入警告及圖層顯示限制。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuphelela kwezingqimba, ukubhaliswa kokubhoboza, kanye nokufaneleka kokukhiqiza akukaqinisekiswa. Hlola izixwayiso zokungenisa kanye nemikhawulo yokubonisa izingqimba."
          }
        }
      }
    },
