          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્તરની સંપૂર્ણતા, ડ્રિલ નોંધણી અને ઉત્પાદન યોગ્યતા ચકાસવામાં આવી નથી. આયાત ચેતવણીઓ અને સ્તર પ્રદર્શન મર્યાદા તપાસો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלמות השכבה, רישום הקידוח והתאמת הייצור לא אומתו. בדקו את אזהרות הייבוא ואת מגבלות תצוגת השכבה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परत की पूर्णता, ड्रिल पंजीकरण और विनिर्माण उपयुक्तता की पुष्टि नहीं की गई है। आयात संबंधी चेतावनियों और परत प्रदर्शन सीमाओं की जाँच करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potpunost sloja, registracija bušenja i prikladnost za proizvodnju nisu provjereni. Provjerite upozorenja o uvozu i ograničenja prikaza slojeva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rétegek teljességét, a fúrási regisztrációt és a gyártási alkalmasságot még nem ellenőrizték. Ellenőrizze az importálási figyelmeztetéseket és a rétegek megjelenítési korlátait."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շերտերի ամբողջականությունը, փորման գրանցումը և արտադրական պիտանիությունը չեն ստուգվել: Ստուգեք ներմուծման նախազգուշացումները և շերտերի ցուցադրման սահմանափակումները:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelengkapan lapisan, registrasi bor, dan kesesuaian untuk produksi belum diverifikasi. Periksa peringatan impor dan batasan tampilan lapisan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heilleiki lagsins, skráning borunar og framleiðsluhæfni hafa ekki verið staðfest. Athugið viðvaranir um innflutning og birtingarmörk lagsins."
