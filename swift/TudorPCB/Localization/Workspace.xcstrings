    "Drag to orbit · Scroll or pinch to zoom · Double-click to fit" : {
      "comment" : "Hint shown at the bottom of the 3D view explaining the mouse and trackpad gestures. The middle dots are separators.",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om te wentel · Blaai of knyp om te zoem · Dubbelklik om aan te pas"
